<?xml version="1.0" encoding="utf-8"?>
<!--
    ILA — Android < 12 Full Backup Rules (android:fullBackupContent)
    Controls Auto Backup behavior for API 23–30.

    AUDIT FIX: Defence-in-depth companion to allowBackup="false".
    Excludes all app data from Auto Backup as an additional safeguard.
-->
<full-backup-content>
    <!-- Exclude all private app storage from Auto Backup -->
    <exclude domain="root"      path="." />
    <exclude domain="file"      path="." />
    <exclude domain="database"  path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external"  path="." />
</full-backup-content>
